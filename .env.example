# Copy to .env for local (non-docker) runs. docker-compose.yml sets these itself.
DATABASE_URL=postgres://dodo:dodo@localhost:5432/dodo
BIND_ADDR=0.0.0.0:8080

# Mock PSP
PSP_BASE_URL=http://localhost:9090
PSP_TIMEOUT_MS=5000
MOCK_PSP_BIND_ADDR=0.0.0.0:9090

# Webhook dispatcher / payment reconciler tuning (optional; sane defaults baked in)
WEBHOOK_MAX_ATTEMPTS=8
RUST_LOG=info,invoice_service=debug,mock_psp=debug,tower_http=info
